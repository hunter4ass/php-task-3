{
  "name": "egor-ilchuk/pop-it-mvc",
  "description": "MVC",
  "type": "project",
  "license": "MIT",
  "authors": [
    {
      "name": "hunter4ass",
      "email": "egorilicu@gmail.com"
    }
  ],
  "minimum-stability": "dev",
  "require": {
    "php": "^7.4 || ^8.0",
    "illuminate/database": "12.x-dev",
    "illuminate/events": "12.x-dev",
    "nikic/fast-route": "^2.0@dev",
    "clinic/collection": "*"
  },
  "repositories": [
    {
      "type": "path",
      "url": "packages/clinic-collection",
      "options": {
        "symlink": true
      }
    }
  ],
  "autoload": {
    "psr-4": {
      "Src\\": "core/Src/",
      "Controller\\": "app/Controller/",
      "Model\\": "app/Model/"
    }
  }
}
